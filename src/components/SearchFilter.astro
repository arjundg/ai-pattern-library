---
interface Props {
  categories: string[];
  difficulties: string[];
}

const { categories, difficulties } = Astro.props;
---

<div class="search-filters">
  <div class="search-bar">
    <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8" />
      <path d="m21 21-4.35-4.35" />
    </svg>
    <input
      type="text"
      id="pattern-search"
      placeholder="Search patterns (e.g., RAG, chain-of-thought, tool use...)"
      autocomplete="off"
    />
  </div>
  <div class="filter-row">
    <div class="filter-group">
      <label>Category</label>
      <select id="filter-category">
        <option value="">All Categories</option>
        {categories.map(cat => (
          <option value={cat}>{cat.charAt(0).toUpperCase() + cat.slice(1).replace('-', ' ')}</option>
        ))}
      </select>
    </div>
    <div class="filter-group">
      <label>Difficulty</label>
      <select id="filter-difficulty">
        <option value="">All Levels</option>
        {difficulties.map(d => (
          <option value={d}>{d.charAt(0).toUpperCase() + d.slice(1)}</option>
        ))}
      </select>
    </div>
    <button id="clear-filters" class="clear-btn" style="display: none;">Clear Filters</button>
  </div>
</div>

<script>
  const searchInput = document.getElementById('pattern-search') as HTMLInputElement;
  const categoryFilter = document.getElementById('filter-category') as HTMLSelectElement;
  const difficultyFilter = document.getElementById('filter-difficulty') as HTMLSelectElement;
  const clearBtn = document.getElementById('clear-filters') as HTMLButtonElement;
  const patternCards = document.querySelectorAll('[data-pattern-card]');
  const noResults = document.getElementById('no-results');

  function filterPatterns() {
    const query = searchInput.value.toLowerCase().trim();
    const category = categoryFilter.value;
    const difficulty = difficultyFilter.value;
    let visibleCount = 0;

    patternCards.forEach(card => {
      const el = card as HTMLElement;
      const title = el.dataset.title?.toLowerCase() || '';
      const desc = el.dataset.description?.toLowerCase() || '';
      const tags = el.dataset.tags?.toLowerCase() || '';
      const cat = el.dataset.category || '';
      const diff = el.dataset.difficulty || '';

      const matchesSearch = !query || title.includes(query) || desc.includes(query) || tags.includes(query);
      const matchesCategory = !category || cat === category;
      const matchesDifficulty = !difficulty || diff === difficulty;

      const visible = matchesSearch && matchesCategory && matchesDifficulty;
      el.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    clearBtn.style.display = (query || category || difficulty) ? '' : 'none';
  }

  searchInput.addEventListener('input', filterPatterns);
  categoryFilter.addEventListener('change', filterPatterns);
  difficultyFilter.addEventListener('change', filterPatterns);

  clearBtn.addEventListener('click', () => {
    searchInput.value = '';
    categoryFilter.value = '';
    difficultyFilter.value = '';
    filterPatterns();
  });
</script>

<style>
  .search-filters {
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .search-bar {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.875rem;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .search-bar input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.75rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text);
    font-size: 1rem;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.2s;
  }

  .search-bar input:focus {
    border-color: var(--color-accent);
  }

  .search-bar input::placeholder {
    color: var(--color-text-muted);
  }

  .filter-row {
    display: flex;
    gap: 1rem;
    align-items: flex-end;
    flex-wrap: wrap;
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .filter-group label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .filter-group select {
    padding: 0.5rem 0.75rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text);
    font-size: 0.875rem;
    font-family: var(--font-sans);
    outline: none;
    cursor: pointer;
    min-width: 160px;
  }

  .filter-group select:focus {
    border-color: var(--color-accent);
  }

  .clear-btn {
    padding: 0.5rem 1rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s;
    font-family: var(--font-sans);
  }

  .clear-btn:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .filter-row {
      flex-direction: column;
      align-items: stretch;
    }
    .filter-group select {
      min-width: unset;
      width: 100%;
    }
  }
</style>
