---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Interactive AI Pattern Library — proven AI engineering patterns with runnable examples' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title} | AI Pattern Library</title>
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a href={`${base}/`} class="logo">
          <span class="logo-icon">🧠</span>
          <span class="logo-text">AI Pattern Library</span>
        </a>
        <div class="nav-links">
          <a href={`${base}/`}>Patterns</a>
          <a href={`${base}/about/`}>About</a>
          <a href="https://github.com/arjundg/ai-pattern-library" target="_blank" rel="noopener">
            GitHub
          </a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-content">
        <p>AI Pattern Library — Open source, community-driven.</p>
        <p>
          <a href="https://github.com/arjundg/ai-pattern-library" target="_blank" rel="noopener">
            Contribute on GitHub
          </a>
        </p>
      </div>
    </footer>

    <!-- Mermaid diagram rendering -->
    <script>
      async function renderMermaid() {
        const mermaidBlocks = document.querySelectorAll('pre[data-language="mermaid"]');
        if (mermaidBlocks.length === 0) return;

        const mermaid = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
        mermaid.default.initialize({
          startOnLoad: false,
          theme: 'dark',
          darkMode: true,
          flowchart: { 
            useMaxWidth: true, 
            htmlLabels: true,
            curve: 'basis'
          },
          themeVariables: {
            darkMode: true,
            background: '#0d1117',
            primaryColor: '#1c2128',
            primaryTextColor: '#e6edf3',
            primaryBorderColor: '#58a6ff',
            lineColor: '#8b949e',
            secondaryColor: '#161b22',
            tertiaryColor: '#0d1117',
            fontSize: '16px'
          }
        });

        for (const preBlock of mermaidBlocks) {
          const code = preBlock.textContent || '';
          const id = `mermaid-${Math.random().toString(36).slice(2, 9)}`;
          try {
            const { svg } = await mermaid.default.render(id, code);
            const div = document.createElement('div');
            div.className = 'mermaid-diagram';
            div.innerHTML = svg;
            preBlock.replaceWith(div);
          } catch (e) {
            console.error('Mermaid render error:', e);
            console.error('Failed code:', code);
          }
        }
      }
      
      // Wait for DOM to be fully loaded
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderMermaid);
      } else {
        renderMermaid();
      }
    </script>

    <style is:global>
      :root {
        --color-bg: #0d1117;
        --color-bg-secondary: #161b22;
        --color-bg-tertiary: #1c2128;
        --color-text: #e6edf3;
        --color-text-muted: #8b949e;
        --color-border: #30363d;
        --color-accent: #58a6ff;
        --color-accent-hover: #79c0ff;
        --color-green: #3fb950;
        --color-orange: #d29922;
        --color-red: #f85149;
        --color-purple: #bc8cff;
        --font-mono: 'Fira Code', 'Cascadia Code', 'JetBrains Mono', monospace;
        --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
        --max-width: 1200px;
        --radius: 8px;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        font-family: var(--font-sans);
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.6;
      }

      a {
        color: var(--color-accent);
        text-decoration: none;
        transition: color 0.2s;
      }

      a:hover {
        color: var(--color-accent-hover);
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--color-bg-secondary);
        border-bottom: 1px solid var(--color-border);
        backdrop-filter: blur(12px);
      }

      .site-header nav {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0.75rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--color-text);
        font-weight: 700;
        font-size: 1.1rem;
      }

      .logo:hover {
        color: var(--color-accent);
      }

      .logo-icon {
        font-size: 1.4rem;
      }

      .nav-links {
        display: flex;
        gap: 1.5rem;
        align-items: center;
      }

      .nav-links a {
        color: var(--color-text-muted);
        font-size: 0.9rem;
        font-weight: 500;
      }

      .nav-links a:hover {
        color: var(--color-text);
      }

      main {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 2rem 1.5rem;
        min-height: calc(100vh - 200px);
      }

      .site-footer {
        border-top: 1px solid var(--color-border);
        padding: 2rem 1.5rem;
        text-align: center;
        color: var(--color-text-muted);
        font-size: 0.85rem;
      }

      .footer-content {
        max-width: var(--max-width);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      /* Code blocks */
      pre {
        background: var(--color-bg-secondary) !important;
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        padding: 1rem;
        overflow-x: auto;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        line-height: 1.7;
        margin: 1rem 0;
      }

      code {
        font-family: var(--font-mono);
        font-size: 0.875em;
      }

      :not(pre) > code {
        background: var(--color-bg-tertiary);
        padding: 0.15em 0.4em;
        border-radius: 4px;
        border: 1px solid var(--color-border);
      }

      /* Mermaid diagrams */
      .mermaid-diagram {
        background: var(--color-bg-tertiary);
        border-radius: var(--radius);
        padding: 2rem;
        margin: 2rem 0;
        text-align: center;
        border: 1px solid var(--color-border);
        overflow-x: auto;
      }

      .mermaid-diagram svg {
        max-width: 100%;
        height: auto;
        display: inline-block;
      }

      /* Ensure mermaid diagram text is visible */
      .mermaid-diagram svg text {
        fill: var(--color-text) !important;
      }

      .mermaid-diagram svg .node rect,
      .mermaid-diagram svg .node circle,
      .mermaid-diagram svg .node polygon {
        fill: var(--color-bg-secondary) !important;
        stroke: var(--color-accent) !important;
      }

      .mermaid-diagram svg .edgePath .path {
        stroke: var(--color-text-muted) !important;
      }

      .mermaid-diagram svg .arrowheadPath {
        fill: var(--color-text-muted) !important;
      }

      /* Headings in content */
      .pattern-content h2 {
        font-size: 1.5rem;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--color-border);
        color: var(--color-text);
      }

      .pattern-content h3 {
        font-size: 1.2rem;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        color: var(--color-text);
      }

      .pattern-content p {
        margin-bottom: 1rem;
        color: var(--color-text-muted);
        line-height: 1.8;
      }

      .pattern-content ul,
      .pattern-content ol {
        margin: 0.75rem 0 1rem 1.5rem;
        color: var(--color-text-muted);
      }

      .pattern-content li {
        margin-bottom: 0.4rem;
        line-height: 1.7;
      }

      .pattern-content strong {
        color: var(--color-text);
      }

      .pattern-content blockquote {
        margin: 1rem 0;
        padding: 0.75rem 1rem;
        border-left: 3px solid var(--color-accent);
        background: var(--color-bg-secondary);
        border-radius: 0 var(--radius) var(--radius) 0;
        color: var(--color-text-muted);
      }

      /* Responsive */
      @media (max-width: 768px) {
        main {
          padding: 1rem;
        }
        .site-header nav {
          padding: 0.75rem 1rem;
          flex-wrap: wrap;
          gap: 0.5rem;
        }
        .nav-links {
          gap: 1rem;
        }
      }
    </style>
  </body>
</html>
