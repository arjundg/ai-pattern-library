# GitLab Pages CI/CD Configuration
# Rename this file to .gitlab-ci.yml to enable GitLab Pages deployment

image: node:20

pages:
  stage: deploy
  cache:
    key:
      files:
        - package-lock.json
    paths:
      - node_modules/
  script:
    - npm ci
    - npm run build
    - cp -r dist public
  artifacts:
    paths:
      - public
  only:
    - main
